# Root-level ignores. The reference implementation keeps its own, fuller
# .gitignore under reference/. This file only covers things that may show
# up at the repository root (agent/editor scratch dirs, OS cruft).

# AI / agent scratch dirs
.claude/*
!.claude/commands/
!.claude/workflows/
.cursor/
.roo/
.cline/
.windsurf/
.serena/
.mcp.json
.playwright-mcp/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build / test output and scratch
.vite/
coverage/
dist/
tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
